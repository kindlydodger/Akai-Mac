{
  "version": 1,
  "targets": [
    {
      "id": "mpc-bridge",
      "name": "MPC Hardware Bridge & MIDI",
      "kind": "mpc_bridge",
      "enabled": true,
      "interval_s": 1.0,
      "config": {
        "host": "mpc-live.local",
        "port": 6731,
        "sniff_leds": false,
        "include_noise": false
      }
    },
    {
      "id": "mpc-screen",
      "name": "MPC Live Screen (:6720)",
      "kind": "http",
      "enabled": true,
      "interval_s": 3.0,
      "config": {
        "url": "http://mpc-live.local:6720/info",
        "timeout_s": 2.0
      }
    },
    {
      "id": "mpc-mirror",
      "name": "Mac Studio Mirror (:6767)",
      "kind": "http",
      "enabled": true,
      "interval_s": 2.0,
      "config": {
        "url": "http://127.0.0.1:6767/api/status",
        "expect_json_key": "ok",
        "timeout_s": 2.0
      }
    },
    {
      "id": "mpc-system",
      "name": "MPC System (Dash · IP/CPU/RAM/Net/Disk/Proc)",
      "kind": "mpc_system",
      "enabled": true,
      "interval_s": 2.0,
      "config": {
        "host": "root@mpc-live.local",
        "timeout_s": 4.0
      }
    },
    {
      "id": "mpc-activity",
      "name": "MCP / CLI / Mirror Activity",
      "kind": "log_tail",
      "enabled": true,
      "interval_s": 0.7,
      "config": {
        "path": "/Users/dogukanatok/.gemini/antigravity/scratch/mpcuter-antigravity-workspace/mpc_control/activity_feed.jsonl",
        "parser": "jsonl_activity",
        "max_initial_lines": 35
      }
    },
    {
      "id": "agent-transcript",
      "name": "Antigravity Live Transcript",
      "kind": "log_tail",
      "enabled": true,
      "interval_s": 1.5,
      "config": {
        "path_glob": "/Users/dogukanatok/.gemini/antigravity/brain/*/.system_generated/logs/transcript.jsonl",
        "parser": "antigravity_transcript",
        "max_initial_lines": 18
      }
    },
    {
      "id": "agent-tasks",
      "name": "Background Task Logs",
      "kind": "dir_watch",
      "enabled": true,
      "interval_s": 2.5,
      "config": {
        "path_glob": "/Users/dogukanatok/.gemini/antigravity/brain/*/.system_generated/tasks/*.log",
        "recent_n": 5
      }
    },
    {
      "id": "mpc-patterns",
      "name": "MIDI Patterns Folder",
      "kind": "dir_watch",
      "enabled": true,
      "interval_s": 5.0,
      "config": {
        "path": "/Users/dogukanatok/.gemini/antigravity/scratch/mpcuter-antigravity-workspace/mpc_control/patterns",
        "recent_n": 10
      }
    },
    {
      "id": "mpc-webhook",
      "name": "Webhook & IAC MIDI (:6780)",
      "kind": "http",
      "enabled": true,
      "interval_s": 2.0,
      "config": {
        "url": "http://127.0.0.1:6780/health",
        "expect_json_key": "ok",
        "timeout_s": 2.0
      }
    },
    {
      "id": "webhook-inbox",
      "name": "Watched Webhook Inbox",
      "kind": "dir_watch",
      "enabled": true,
      "interval_s": 1.0,
      "config": {
        "path": "/Users/dogukanatok/.gemini/antigravity/scratch/mpcuter-antigravity-workspace/mpc_control/webhook_inbox",
        "recent_n": 10
      }
    }
  ]
}
